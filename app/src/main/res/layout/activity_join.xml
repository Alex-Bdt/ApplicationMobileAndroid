<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join a Game"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Searching..."
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp" />

    <!-- Liste des salles trouvées -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="24dp" />

    <!-- Section PIN -->
    <LinearLayout
        android:id="@+id/pinLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saisissez le PIN du host"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:hint="_ _ _ _"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:inputType="number"
            android:maxLength="4"
            android:gravity="center"
            android:textSize="32sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSubmitPin"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:text="Valider le PIN"
            android:textColor="#FFFFFF"
            android:backgroundTint="#BB86FC" />

    </LinearLayout>

    <!-- Salle d'attente :visible après PIN validé -->
    <LinearLayout
        android:id="@+id/waitingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joueurs dans la salle"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWaitingPlayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En attente du lancement par le host..."
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>