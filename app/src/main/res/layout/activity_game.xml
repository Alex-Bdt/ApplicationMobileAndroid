<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:padding="16sp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8sp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 pts"
            android:textSize="18sp"
            android:textColor="#aaa" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10s"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#fff" />
    </LinearLayout>

    <!-- Combo et points gagnés -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8sp">

        <TextView
            android:id="@+id/tvCombo"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 ×1.2  combo 2"
            android:textSize="13sp"
            android:textColor="#ff9800"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvLastPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+100 pts"
            android:textSize="13sp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Photo qui doit être trouvé -->
    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="0sp"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        android:background="#1E1E1E"
        android:layout_marginBottom="12sp" />

    <!-- Ligne boutons 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8sp">

        <Button
            android:id="@+id/btnChoice1"
            android:layout_width="0sp"
            android:layout_height="48sp"
            android:layout_weight="1"
            android:layout_marginEnd="4sp"
            android:textColor="#fff"
            android:backgroundTint="#000" />

        <Button
            android:id="@+id/btnChoice2"
            android:layout_width="0sp"
            android:layout_height="48sp"
            android:layout_weight="1"
            android:layout_marginStart="4sp"
            android:textColor="#fff"
            android:backgroundTint="#000" />
    </LinearLayout>

    <!-- Ligne boutons 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8sp">

        <Button
            android:id="@+id/btnChoice3"
            android:layout_width="0sp"
            android:layout_height="48sp"
            android:layout_weight="1"
            android:layout_marginEnd="4sp"
            android:textColor="#fff"
            android:backgroundTint="#000" />

        <Button
            android:id="@+id/btnChoice4"
            android:layout_width="0sp"
            android:layout_height="48sp"
            android:layout_weight="1"
            android:layout_marginStart="4sp"
            android:textColor="#fff"
            android:backgroundTint="#000" />
    </LinearLayout>

    <!-- Bouton suivant -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:text="@string/nextImage"
        android:textColor="#fff"
        android:backgroundTint="#BA3406"
        android:visibility="gone" />
</LinearLayout>
